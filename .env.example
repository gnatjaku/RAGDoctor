# Kopiuj ten plik do .env i ustaw bezpieczne haslo
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=ChangeMeToAStrongPassword

# Aplikacja
MONGO_URI=mongodb://admin:ChangeMeToAStrongPassword@localhost:27017
MONGO_DB_NAME=ragdoctor
MONGO_COLLECTION_NAME=chunks

# OpenAI embeddings (ada-002 = 1536, text-embedding-3-small = 1536, text-embedding-3-large = 3072)
EMBEDDING_DIMENSIONS=1536
