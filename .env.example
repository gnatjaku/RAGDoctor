# Kopiuj ten plik do .env i ustaw bezpieczne hasło
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=ChangeMeToAStrongPassword

# Aplikacja FastAPI
MONGODB_URI=mongodb://admin:ChangeMeToAStrongPassword@localhost:27017/?authSource=admin
MONGODB_DB=rag_db
MONGODB_COLLECTION=documents
MONGODB_VECTOR_INDEX=vector_index

# Tryb AI
LLM_BACKEND=ollama
OLLAMA_CHAT_MODEL=doctor
OLLAMA_BASE_URL=http://host-gateway:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_CHAT_MODEL=google/gemma-4-12B
LM_STUDIO_MAX_TOKENS=1024
EMBEDDING_BACKEND=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3

# Alternatywny backend OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# RAG
RAG_TOP_K=5
RAG_SIMILARITY_DEVICE=auto
RAG_MIN_CONTEXT_SCORE=0.2
RAG_ALWAYS_KEEP_TOP_CHUNK=true
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARS=4000
CHUNK_SIZE=800
CHUNK_OVERLAP=120
LOG_LEVEL=DEBUG

# Wymiar embeddingów zależy od modelu. bge-m3 w Ollamie zwraca 1024 wymiary.
EMBEDDING_DIMENSIONS=1024
