# Kopiuj ten plik do .env i ustaw bezpieczne hasło
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=ChangeMeToAStrongPassword

# Aplikacja FastAPI
MONGODB_URI=mongodb://admin:ChangeMeToAStrongPassword@localhost:27017/?authSource=admin
MONGODB_DB=rag_db
MONGODB_COLLECTION=documents
MONGODB_VECTOR_INDEX=vector_index

# Tryb AI
LLM_BACKEND=ollama
OLLAMA_CHAT_MODEL=doctor
OLLAMA_BASE_URL=http://host-gateway:11434
EMBEDDING_BACKEND=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Alternatywny backend OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# RAG
RAG_TOP_K=5
MAX_CONTEXT_CHUNKS=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
LOG_LEVEL=DEBUG

# OpenAI embeddings (ada-002 = 1536, text-embedding-3-small = 1536, text-embedding-3-large = 3072)
EMBEDDING_DIMENSIONS=1536
