+    function renderCitations(citations) {
+        if (!citations || citations.length === 0) return '';
+        const items = citations.map(c => {
+            const url = c.metadata?.url
+                ? `<a href="${c.metadata.url}" target="_blank">🔗 ${c.metadata.url}</a>`
+                : '';
+            const score = `<span class="score">Trafność: ${(c.score * 100).toFixed(1)}%</span>`;
+            const text = `<div class="chunk-text">${escHtml(c.text)}</div>`;
+            const src  = `<strong>${escHtml(c.source_name)}</strong>`;
+            return `<div class="citation-item">${src} ${score}${url}${text}</div>`;
+        }).join('');
+        return `<details class="citations"><summary>📚 Źródła (${citations.length})</summary>${items}</details>`;
+    }
 
